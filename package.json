{
  "name": "vs-journal-tag",
  "displayName": "VS Journal",
  "publisher": "watagashi-dev",
  "description": "%extension.description%",
  "version": "0.4.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "journal",
    "memo",
    "notes",
    "tags"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/watagashi-dev/vs-journal"
  },
  "bugs": {
    "url": "https://github.com/watagashi-dev/vs-journal/issues"
  },
  "homepage": "https://github.com/watagashi-dev/vs-journal#readme",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "vs-journal.newEntry",
        "title": "%command.newEntry%",
        "icon": "$(new-file)"
      },
      {
        "command": "vs-journal.previewEntry",
        "title": "%command.previewEntry%",
        "icon": "$(preview)"
      },
      {
        "command": "vs-journal.selectJournalDir",
        "title": "%command.selectJournalDir%",
        "icon": "$(gear)"
      },
      {
        "command": "vs-journal.addVirtualTag",
        "title": "%command.addVirtualTag%",
        "icon": "$(tag)"
      },
      {
        "command": "vsJournal.deleteFile",
        "title": "%command.deleteFile.title%"
      },
      {
        "command": "vsJournal.deleteVirtualTag",
        "title": "%command.deleteVirtualTag.title%"
      },
      {
        "command": "vsJournal.paste",
        "title": "%command.paste%"
      },
      {
        "command": "vsJournal.insertFile",
        "title": "%command.insertFile%"
      },
      {
        "command": "vsJournal.insertFolder",
        "title": "%command.insertFolder%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "vsJournal.journalDir": {
          "type": "string",
          "markdownDescription": "%config.journalDir.markdownDescription%"
        },
        "vsJournal.autoSave": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "description": "%config.autoSave%",
          "markdownDescription": "%config.autoSaveMarkdown%"
        },
        "vsJournal.enableDateTime": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableDateTime.description%",
          "markdownDescription": "%config.enableDateTime.markdownDescription%"
        },
        "vsJournal.confirmDeleteFile": {
          "type": "boolean",
          "default": true,
          "description": "%config.confirmDeleteFile.description%",
          "markdownDescription": "%config.confirmDeleteFile.markdownDescription%"
        },
        "vsJournal.confirmDeleteVirtualTag": {
          "type": "boolean",
          "default": true,
          "description": "%config.confirmDeleteVirtualTag.description%",
          "markdownDescription": "%config.confirmDeleteVirtualTag.markdownDescription%"
        },
        "vsJournal.virtualTags.caseSensitive": {
          "type": "boolean",
          "default": false,
          "description": "%config.virtualTags.caseSensitive.description%",
          "markdownDescription": "%config.virtualTags.caseSensitive.markdownDescription%"
        },
        "vsJournal.systemTags.visibility": {
          "type": "object",
          "default": {
            "Today": true
          },
          "properties": {
            "Today": {
              "type": "boolean",
              "default": true,
              "description": "%config.systemTags.today.description%"
            }
          },
          "additionalProperties": false,
          "markdownDescription": "%config.systemTags.today.markdownDescription%"
        },
        "vsJournal.fileNameStyle": {
          "type": "string",
          "enum": [
            "datetime-minute",
            "datetime-hour",
            "date-only",
            "compact-datetime"
          ],
          "enumDescriptions": [
            "2026-05-05-13-45",
            "2026-05-05-13",
            "2026-05-05",
            "20260505-1345"
          ],
          "default": "datetime-minute",
          "description": "%config.fileNameStyle.description%",
          "markdownDescription": "%config.fileNameStyle.markdownDescription%"
        },
        "vsJournal.folderStructure": {
          "type": "string",
          "enum": [
            "flat",
            "yyyy",
            "yyyy-mm",
            "yyyy-mm-dd"
          ],
          "enumDescriptions": [
            "%config.folderStructure.flat%",
            "%config.folderStructure.year%",
            "%config.folderStructure.yearMonth%",
            "%config.folderStructure.yearMonthDay%"
          ],
          "default": "flat",
          "description": "%config.folderStructure.description%",
          "markdownDescription": "%config.folderStructure.markdownDescription%"
        },
        "vsJournal.paste.saveLocation": {
          "type": "string",
          "enum": [
            "flat",
            "structured"
          ],
          "enumDescriptions": [
            "%config.paste.saveLocation.flat%",
            "%config.paste.saveLocation.structured%"
          ],
          "default": "structured",
          "description": "%config.paste.saveLocation.description%",
          "markdownDescription": "%config.paste.saveLocation.markdownDescription%"
        },
        "vsJournal.internalOpenExtensions": {
          "type": "array",
          "default": [
            ".md"
          ],
          "items": {
            "type": "string"
          },
          "description": "%config.internalOpenExtensions.description%",
          "markdownDescription": "%config.internalOpenExtensions.markdownDescription%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vsJournal",
          "title": "VS Journal",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "vsJournal": [
        {
          "id": "VSJournal.TagTree",
          "name": ""
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "VSJournal.TagTree",
        "contents": "%view.vsJournal.tags.empty%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vs-journal.newEntry",
          "when": "view == VSJournal.TagTree",
          "group": "navigation@1"
        },
        {
          "command": "vs-journal.previewEntry",
          "when": "view == VSJournal.TagTree",
          "group": "navigation@2"
        },
        {
          "command": "vs-journal.selectJournalDir",
          "when": "view == VSJournal.TagTree",
          "group": "navigation@3"
        },
        {
          "command": "vs-journal.addVirtualTag",
          "when": "view == VSJournal.TagTree",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "vs-journal.newEntry"
        },
        {
          "command": "vs-journal.previewEntry",
          "when": "view.VSJournal.TagTree.visible"
        },
        {
          "command": "vs-journal.selectJournalDir"
        },
        {
          "command": "vs-journal.addVirtualTag",
          "when": "view.VSJournal.TagTree.visible"
        }
      ],
      "view/item/context": [
        {
          "command": "vsJournal.deleteFile",
          "when": "view == VSJournal.TagTree && viewItem == file"
        },
        {
          "command": "vsJournal.deleteVirtualTag",
          "when": "view == VSJournal.TagTree && viewItem =~ /tag:virtual/"
        }
      ],
      "editor/context": [
        {
          "command": "vsJournal.paste",
          "when": "editorTextFocus && resourceExtname == .md",
          "group": "z_vsjournal@1"
        },
        {
          "command": "vsJournal.insertFile",
          "when": "editorTextFocus && resourceExtname == .md",
          "group": "z_vsjournal@2"
        },
        {
          "command": "vsJournal.insertFolder",
          "when": "editorTextFocus && resourceExtname == .md",
          "group": "z_vsjournal@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vs-journal.newEntry",
        "key": "ctrl+alt+n",
        "mac": "cmd+option+n"
      },
      {
        "command": "vs-journal.previewEntry",
        "when": "view.VSJournal.TagTree.visible",
        "key": "ctrl+alt+p",
        "mac": "cmd+option+p"
      },
      {
        "command": "vsJournal.paste",
        "when": "editorTextFocus && resourceExtname == .md",
        "key": "ctrl+alt+v",
        "mac": "cmd+option+v"
      },
      {
        "command": "vsJournal.insertFile",
        "when": "editorTextFocus && resourceExtname == .md",
        "key": "ctrl+alt+i",
        "mac": "cmd+option+i"
      },
      {
        "command": "vsJournal.insertFolder",
        "when": "editorTextFocus && resourceExtname == .md",
        "key": "ctrl+alt+shift+i",
        "mac": "cmd+option+shift+i"
      }
    ]
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:extension && npm run build:webview",
    "build:extension": "tsc -p ./tsconfig.json",
    "build:webview:copy": "copyfiles -u 2 src/webview/*.css dist/webview && npm run build:webview:copy-katex",
    "build:webview:copy-katex": "copyfiles -u 2 src/webview/katex/**/* dist/webview",
    "build:webview": "tsc -p ./tsconfig.webview.json && npm run build:webview:copy && npm run build:webview:copy-html",
    "build:webview:copy-html": "copyfiles -u 2 src/webview/template.html dist/webview",
    "watch": "concurrently \"npm:watch:extension\" \"npm:watch:webview\"",
    "watch:extension": "tsc -w -p ./tsconfig.json",
    "watch:webview": "tsc -w -p ./tsconfig.webview.json",
    "lint": "eslint src",
    "test": "vscode-test",
    "pretest": "npm run compile-tests && npm run lint",
    "compile-tests": "tsc -p . --outDir out"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.3",
    "npm-run-all": "^1.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.36.0"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "markdown-it": "^14.1.1",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "open": "^11.0.0"
  }
}